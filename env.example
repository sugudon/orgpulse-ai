# ==========================================
# OrgPulse AI - Environment Variables
# ==========================================

# Application
APP_NAME=OrgPulse AI
APP_ENV=development
DEBUG=true

# ==========================================
# LLM Provider
# ==========================================

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=

# Ollama (optional - local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ==========================================
# Embeddings
# ==========================================

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# PostgreSQL + pgvector
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orgpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Full database URL
DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/orgpulse

# ==========================================
# RAG Configuration
# ==========================================

CHUNK_SIZE=800
CHUNK_OVERLAP=150

VECTOR_TOP_K=10
BM25_TOP_K=10
RERANK_TOP_K=5

HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# ==========================================
# Reranker
# ==========================================

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==========================================
# File Upload
# ==========================================

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ==========================================
# Streamlit / FastAPI
# ==========================================

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

STREAMLIT_API_URL=http://localhost:8000
